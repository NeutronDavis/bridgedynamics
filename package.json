{
  "name": "bridge-dynamics-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "playwright-core": "1.61.1",
    "postcss": "8.5.23",
    "sharp": "0.35.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-csp.mjs && node scripts/verify-export.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-playwright.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:language": "node scripts/check-language.mjs"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "daisyui": "^5.7.16",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "jsdom": "28.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
